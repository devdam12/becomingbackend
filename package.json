{
  "name": "becoming-conference-backend",
  "version": "1.0.0",
  "description": "MongoDB-backed conference registration and attendee management",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "admin:create": "node scripts/create-admin.js",
    "test": "node --test test/*.test.js",
    "check": "node scripts/check.js",
    "build": "node scripts/check.js",
    "lint": "node node_modules/eslint/bin/eslint.js src scripts test",
    "test:live": "node --test test/mongo.live.js",
    "admin:set": "node scripts/set-admin.js"
  },
  "keywords": [],
  "type": "commonjs",
  "private": true,
  "engines": {
    "node": ">=22.13"
  },
  "dependencies": {
    "express": "5.2.1",
    "helmet": "8.3.0",
    "express-rate-limit": "8.7.0",
    "zod": "4.4.3",
    "dotenv": "17.4.2",
    "mongodb": "6.20.0"
  },
  "devDependencies": {
    "eslint": "9.39.5"
  }
}
